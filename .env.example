# Server only. Copy to .env.local and add your own Twelve Data key.
TWELVE_DATA_API_KEY=
# Basic limits: 8/min, 800/day. Reserve 50 daily credits for operational headroom.
TWELVE_DATA_DAILY_BUDGET=750
TWELVE_DATA_MINUTE_BUDGET=8
# Minimum 120 seconds; increase for a smaller/shared account quota.
TWELVE_DATA_QUOTE_SECONDS=120
# Shared stock-tape allowance, INCLUDED in the global daily budget. 0 disables rotation.
TWELVE_DATA_TICKER_DAILY_BUDGET=180

# Vercel: Upstash Redis REST credentials (server-only; Marketplace integration).
# Also accepts KV_REST_API_URL / KV_REST_API_TOKEN from older Vercel integrations.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# All instances/environments using ONE Twelve Data key must share ONE namespace.
# Never clear this keyspace: it contains the daily quota journal.
MARKET_REDIS_NAMESPACE=twun-market-v1

# News: separate provider key, server-only. Stock prices still use Twelve Data.
FINNHUB_API_KEY=
NEWS_REDIS_NAMESPACE=twun-news-v1
NEWS_REFRESH_SECONDS=600
NEWS_CATALOG_REFRESH_SECONDS=21600
NEWS_API_MINUTE_BUDGET=10
NEWS_API_DAILY_BUDGET=500

# Public Robinhood Chain contract address, NOT a private key. Rebuild after changing.
NEXT_PUBLIC_TWUN_CONTRACT_ADDRESS=

# Feedback: private team inbox token, at least 32 random characters. Server-only.
FEEDBACK_ADMIN_TOKEN=
# Dedicated namespace; uses the shared Redis credentials above on Vercel.
FEEDBACK_REDIS_NAMESPACE=twun-feedback-v1
